# Optional local backend overrides: copy to
# .runtime/product-local-live/backend.env, owner=current user, mode=0600.
# This does NOT replace config.json, network.env, execution-binding.json,
# material-storage.json, .env.runtime or .env.agent. Never reinitialize them.
# Priority: explicitly allowlisted shell variables > backend.env > existing
# local private files > local defaults. Other ambient SG_*/AWS_* are ignored.
# Database/auth/development SMS secrets stay owned by config.json.
# SMS_MODE and SMS_ALIYUN_* may be overridden as in the production template.
# Uncomment only fields you intend to override.
# SG_PRODUCT_WEB_PORT=3100
# SG_PRODUCT_BACKEND_PORT=4320
# SG_PRODUCT_BUSINESS_MODEL_MODE=artemis_configured
# SG_PRODUCT_ARTEMIS_ROOT=/absolute/path/to/google-artemis

# A material override replaces the WHOLE old material group. Supply all fields,
# or use MODE=unavailable alone to disable. Never mix credentials from two sources.
# SG_PRODUCT_MATERIAL_MODE=configured
# SG_PRODUCT_MATERIAL_PROVIDER=oss_s3
# SG_PRODUCT_MATERIAL_LOCATION_ID=<existing stable location UUID>
# SG_PRODUCT_MATERIAL_ENDPOINT=https://s3.oss-cn-hongkong.aliyuncs.com
# SG_PRODUCT_MATERIAL_REGION=cn-hongkong
# SG_PRODUCT_MATERIAL_BUCKET=<existing private bucket>
# SG_PRODUCT_MATERIAL_FORCE_PATH_STYLE=false
# SG_PRODUCT_MATERIAL_ACCESS_KEY=<access key>
# SG_PRODUCT_MATERIAL_SECRET_KEY=<secret>
# SG_PRODUCT_MATERIAL_SESSION_TOKEN=<optional; omit when unused>
# SG_PRODUCT_MATERIAL_MAX_OBJECT_BYTES=134217728
# SG_PRODUCT_MATERIAL_REQUEST_TIMEOUT_MS=30000

# Execution, media grant and network fields have the same SG_PRODUCT_* names
# as .env.production.example. They must describe this local database/environment.
# Existing execution-binding.json and network.env remain supported.
# SG_PRODUCT_EXECUTION_RUNTIME_URL=http://127.0.0.1:4318
# SG_PRODUCT_EXECUTION_RUNTIME_TOKEN=<existing runtime token>
# SG_PRODUCT_EXECUTION_CALLBACK_URL=http://127.0.0.1:4320

# Real SMS: set SG_PRODUCT_SMS_MODE=aliyun plus all SMS_ALIYUN_* fields.
# Development capture is disabled automatically when another SMS mode is selected.

# B1 initial phone transport; enable only with the paired backend/executor candidate.
SG_PRODUCT_BOOTSTRAP_ENABLED=false
