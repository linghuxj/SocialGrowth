# Reference for the EXISTING executor's .env.runtime (0600); merge manually.
# Never overwrite existing secrets, device tokens, state directory or bindings.
# Do not rerun executor:setup for an already initialized executor.
SG_RUNTIME_HOST=127.0.0.1
SG_RUNTIME_PORT=4318
SG_RUNTIME_URL=http://127.0.0.1:4318
SG_RUNTIME_DATA=.runtime
# SG_RUNTIME_TOKEN=<existing operator token>
# SG_MEDIA_SIGNING_KEY=<existing media signing key>
# SG_DEVICE_TOKENS='<existing JSON mapping of serial to agent token>'
# Host defaults to loopback. Docker execution overlay sets 0.0.0.0 inside
# its private network without publishing a host port. URL alone changes no listener.
# SG_MEDIA_BASE_URL=https://executor.example.invalid
# SG_ALLOWED_ORIGINS=https://mhtm.top
# SG_ARTEMIS_ROOT=/absolute/path/to/google-artemis
# SG_PYTHON_PATH=/absolute/path/to/google-artemis/.venv/bin/python
# SG_APP_CATALOG=/absolute/path/to/android-packages/catalog.json
# SG_APP_STORAGE_FILE=/absolute/path/to/private/app-storage.json
# SG_ANDROID_BUILD_TOOLS=/absolute/path/to/android-sdk/build-tools/36.0.0
# Agent process also needs SG_APP_CATALOG / SG_ANDROID_BUILD_TOOLS in .env.agent.

# Existing runtime/product binding, matching the SAME product DB and device.
# SG_PRODUCT_EXECUTION_RUNTIME_TOKEN=<same token as product backend>
# SG_PRODUCT_EXECUTION_RUNTIME_BINDING_ID=<existing binding>
# SG_PRODUCT_EXECUTION_SERIAL=<physical serial>
# SG_PRODUCT_EXECUTION_DEVICE_ID=<product device UUID>
# SG_PRODUCT_EXECUTION_IDENTITY_ID=<product identity UUID>
# SG_PRODUCT_EXECUTION_CANONICAL_REF=<canonical identity reference>
# SG_PRODUCT_EXECUTION_ACCOUNT_ID=<product account UUID>
# SG_PRODUCT_EXECUTION_RUNTIME_ACCOUNT_ID=<executor account ID>
# SG_PRODUCT_EXECUTION_PAGE_NAME=<authorized page name>
# SG_PRODUCT_EXECUTION_CALLBACK_URL=https://mhtm.top

# Screenshot bytes use an existing private cloud bucket. No MinIO defaults,
# no bucket creation, no ambient AWS credential fallback, no automatic retry.
SG_SCREENSHOT_MODE=unavailable
# SG_SCREENSHOT_MODE=configured
# SG_SCREENSHOT_PROVIDER=oss_s3
# SG_SCREENSHOT_ENDPOINT=https://s3.oss-cn-hongkong.aliyuncs.com
# SG_SCREENSHOT_REGION=cn-hongkong
# SG_SCREENSHOT_BUCKET=<existing private bucket>
# SG_SCREENSHOT_FORCE_PATH_STYLE=false
# SG_SCREENSHOT_ACCESS_KEY=<access key>
# SG_SCREENSHOT_SECRET_KEY=<secret>
# SG_SCREENSHOT_SESSION_TOKEN=<optional; omit when unused>
# SG_SCREENSHOT_REQUEST_TIMEOUT_MS=30000

# B1 initial phone transport; enable only with the paired backend/executor candidate.
SG_PRODUCT_BOOTSTRAP_ENABLED=false

# Private initialization manifest. No auth keys or subscription URLs in env/console.
# SG_PHONE_INITIALIZATION_FILE=/absolute/path/to/private/phone-preparation/initialization.json
