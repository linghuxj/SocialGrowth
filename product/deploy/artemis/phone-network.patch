+    async def check_phone_network(stage: str = "proxy") -> str:
+        """Read-only checks pinned to this Web phone initialization. Use proxy after
+        FlClash Global/local 7890/VPN OFF is ready, BEFORE SFA configuration. Use vpn
+        after SFA starts: verify sole active SFA VPN, management excluded, FB/YT routed.
+        No shell, URL, device, node or credentials arguments. Failed checks are blockers;
+        never infer completion from service presence or repeatedly switch nodes.
+        """
+        if stage not in {"proxy", "vpn"}:
+            return "PHONE_NETWORK_STAGE_INVALID"
+        try:
+            return json.dumps(await asyncio.to_thread(request, "phone-network-ready", {"stage": stage}, 45))
+        except Exception as error:
+            code = str(error)
+            return code if re.fullmatch(r"[A-Z_]{1,80}", code) else "PHONE_NETWORK_UNCONFIRMED"
+
