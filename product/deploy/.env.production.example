# Copy to a protected file OUTSIDE a Git checkout. Replace both secrets.
SG_PRODUCT_REVISION=local-validation
SG_PRODUCT_ENV_FILE=.env.production.example
SG_PRODUCT_PRIVATE_DIR=/absolute/path/to/private
SG_PRODUCT_BIND_ADDRESS=127.0.0.1
SG_PRODUCT_SITE_ADDRESS=mhtm.top
SG_PRODUCT_HTTP_PORT=80
SG_PRODUCT_HTTPS_PORT=443
SG_PRODUCT_POSTGRES_PASSWORD=replace-with-random-hex-secret
SG_PRODUCT_DATABASE_URL=postgresql://socialgrowth_product:replace-with-random-hex-secret@postgres:5432/socialgrowth_product
SG_PRODUCT_AUTH_PEPPER=replace-with-independent-random-hex-secret-at-least-32-characters
SG_PRODUCT_SMS_MODE=unavailable
# Public release APK directory; no credentials or private material in this path.
SG_PRODUCT_PUBLIC_DIR=/opt/socialgrowth/public
# User-authorized temporary Android auto-fill, no SMS delivery/phone possession proof:
# SG_PRODUCT_SMS_MODE=temporary_api
SG_PRODUCT_MEDIA_CREDENTIAL_KEY_FILE=/run/socialgrowth-private/media-credential-keys.json
# Retain existing executor state. Configure a reachable trusted executor later.
# SG_PRODUCT_EXECUTION_RUNTIME_URL=https://executor.example.invalid
# SG_PRODUCT_EXECUTION_RUNTIME_TOKEN=...

# Cloud storage is closed until ALL configured fields below are supplied.
SG_PRODUCT_MATERIAL_MODE=unavailable
# SG_PRODUCT_MATERIAL_MODE=configured
# SG_PRODUCT_MATERIAL_PROVIDER=oss_s3
# Use provider=s3 for AWS S3 or another compatible S3 service.
# SG_PRODUCT_MATERIAL_LOCATION_ID=<stable UUID; never change for an existing location>
# SG_PRODUCT_MATERIAL_ENDPOINT=https://s3.oss-cn-hongkong.aliyuncs.com
# SG_PRODUCT_MATERIAL_REGION=cn-hongkong
# SG_PRODUCT_MATERIAL_BUCKET=<existing private bucket>
# SG_PRODUCT_MATERIAL_FORCE_PATH_STYLE=false
# SG_PRODUCT_MATERIAL_ACCESS_KEY=<RAM access key ID>
# SG_PRODUCT_MATERIAL_SECRET_KEY=<RAM secret>
# SG_PRODUCT_MATERIAL_SESSION_TOKEN=<optional STS token; omit if unused>
# SG_PRODUCT_MATERIAL_MAX_OBJECT_BYTES=134217728
# SG_PRODUCT_MATERIAL_REQUEST_TIMEOUT_MS=30000

# Model execution stays disabled until the runtime image includes Python,
# the Artemis checkout/venv/private .env and scripts/artemis-business-model.py.
# Video analysis also requires ffmpeg and ffprobe in PATH.
SG_PRODUCT_BUSINESS_MODEL_MODE=unavailable
# SG_PRODUCT_BUSINESS_MODEL_MODE=artemis_configured
# SG_PRODUCT_ARTEMIS_ROOT=/opt/artemis

# The executor URL/token above enable connection only. Real execution also needs
# existing, authorized records in THIS product database; do not copy local IDs.
# SG_PRODUCT_EXECUTION_RUNTIME_BINDING_ID=<existing binding>
# SG_PRODUCT_EXECUTION_SERIAL=<physical device serial>
# SG_PRODUCT_EXECUTION_DEVICE_ID=<product device UUID>
# SG_PRODUCT_EXECUTION_IDENTITY_ID=<product identity UUID>
# SG_PRODUCT_EXECUTION_CANONICAL_REF=<canonical identity reference>
# SG_PRODUCT_EXECUTION_ACCOUNT_ID=<product account UUID>
# SG_PRODUCT_EXECUTION_PAGE_NAME=<authorized page name>

# Media-input authorization signing is separate from credential encryption.
# Supply all four together, with the private key mounted inside the container.
# SG_PRODUCT_MEDIA_INPUT_GRANT_KEY_FILE=/run/socialgrowth-private/media-input-key.pem
# SG_PRODUCT_MEDIA_INPUT_GRANT_KEY_ID=<64 lowercase hex characters>
# SG_PRODUCT_MEDIA_INPUT_GRANT_NOT_BEFORE_MILLIS=<epoch milliseconds>
# SG_PRODUCT_MEDIA_INPUT_GRANT_NOT_AFTER_MILLIS=<epoch milliseconds>

# Optional device network authority. Paths are INSIDE the process/container,
# not paths from the Mac. Current production image has no Tailscale or ADB.
# SG_PRODUCT_TAILNET_PILOT_CONFIG=/run/socialgrowth-private/network-pilot.json
# SG_PRODUCT_TAILNET_PILOT_AUTH_KEY_FILE=/run/socialgrowth-private/tailnet-key.json
# SG_PRODUCT_TAILSCALE_CLI=/usr/bin/tailscale
# SG_PRODUCT_CENTER_ADB=/usr/bin/adb
# SG_PRODUCT_CENTER_ADB_USER_HOME=/var/lib/socialgrowth-adb
# SG_PRODUCT_CENTER_ADB_TAILSCALE_CLI=/usr/bin/tailscale

# Component exists, but is NOT registered in the formal application.
# Do not enable this merely because Compose starts Redis.
SG_PRODUCT_QUEUE_MODE=unavailable
# SG_PRODUCT_QUEUE_ENDPOINT=rediss://queue.example.invalid:6379/0
# SG_PRODUCT_QUEUE_USERNAME=<ACL username>
# SG_PRODUCT_QUEUE_PASSWORD=<ACL password>
# SG_PRODUCT_QUEUE_NAME=task-recheck
# SG_PRODUCT_QUEUE_PREFIX=socialgrowth
# SG_PRODUCT_QUEUE_REQUEST_TIMEOUT_MS=5000

# Alibaba Cloud China-site domestic verification SMS. Keep unavailable until
# approved sign/templates and explicit RAM credentials have all been supplied.
# SG_PRODUCT_SMS_MODE=aliyun
# SG_PRODUCT_SMS_ALIYUN_ACCESS_KEY_ID=<RAM key>
# SG_PRODUCT_SMS_ALIYUN_ACCESS_KEY_SECRET=<RAM secret>
# SG_PRODUCT_SMS_ALIYUN_SECURITY_TOKEN=<optional STS token>
# SG_PRODUCT_SMS_ALIYUN_SIGN_NAME=<approved sign>
# SG_PRODUCT_SMS_ALIYUN_REGISTRATION_TEMPLATE=SMS_...
# SG_PRODUCT_SMS_ALIYUN_LOGIN_TEMPLATE=SMS_...
# SG_PRODUCT_SMS_ALIYUN_CODE_PARAMETER=code
# SG_PRODUCT_SMS_ALIYUN_TIMEOUT_MS=10000

# Optional full server execution overlay (compose.execution.yml).
SG_ARTEMIS_IMAGE=socialgrowth-artemis:351ca8422f7b5b54e80a9c1ce03a222e02415b6b
SG_ARTEMIS_ENV_FILE=/absolute/path/to/private/artemis.env
SG_ARTEMIS_CONFIG_FILE=/absolute/path/to/private/artemis.jsonc
SG_ADB_STATE_DIR=/absolute/path/to/private/adb
SG_EXECUTOR_ENV_FILE=.env.executor.example
SG_EXECUTOR_STATE_DIR=/absolute/path/to/private/executor-state
