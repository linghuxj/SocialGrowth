diff --git a/tests/unit/agents/test_checker_structured_report.py b/tests/unit/agents/test_checker_structured_report.py
index 3eaa878..e591430 100644
--- a/tests/unit/agents/test_checker_structured_report.py
+++ b/tests/unit/agents/test_checker_structured_report.py
@@ -55 +55,32 @@ async def test_structured_report_keeps_user_ending_conversation_as_is():
     assert structured.ainvoke.call_args.args[0] is messages
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("wrapped,provider", [(False, "openai"), (True, "openai"), (True, "google")])
+async def test_openai_compatible_checker_uses_inlined_function_schema(monkeypatch, wrapped, provider):
+    import json
+    from langchain_openai import ChatOpenAI
+    from langchain_core.utils.function_calling import convert_to_openai_tool
+
+    schema = json.dumps(convert_to_openai_tool(CheckReport))
+    assert '"$defs"' not in schema
+    assert '"$ref"' not in schema
+    structured = MagicMock()
+    structured.ainvoke = AsyncMock(return_value=CheckReport(verdicts=[]))
+    captured = {}
+
+    def build(self, schema, **kwargs):
+        captured.update(kwargs)
+        return structured
+
+    monkeypatch.setattr(ChatOpenAI, "with_structured_output", build)
+    llm = ChatOpenAI(api_key="test-not-real", model="gemini-test")
+    if wrapped:
+        from artemis.services.llm import RobustChatModelWrapper
+        from artemis.llm.router import ModelEndpoint, ModelProvider
+        llm = RobustChatModelWrapper(
+            llm.with_config(), None,
+            endpoint=ModelEndpoint(provider=ModelProvider.from_string(provider), model_name="gemini-test"),
+        )
+    await _structured_report(llm, [HumanMessage(content="Return verdict.")])
+    assert captured == {"method": "function_calling"}
