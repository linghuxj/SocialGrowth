@@ -0,0 +1,35 @@
+import pytest
+from pydantic import BaseModel
+from artemis.llm.proxy_compat import ProxyChatOpenAI, RequestBudgetExceeded
+from artemis.llm.reliability import classify_failure, FailureCategory
+
+
+class Nested(BaseModel):
+    value: str
+
+
+class Result(BaseModel):
+    result: Nested
+
+
+def test_tool_schema_and_budget(monkeypatch):
+    model = ProxyChatOpenAI(model="test", api_key="unused", max_retries=0)
+    bound = model.with_structured_output(Result, method="json_schema")
+    first = bound.steps[0]
+    assert "tools" in first.kwargs
+    assert "response_format" not in first.kwargs
+    payload = model._get_request_payload("small")
+    assert payload["messages"]
+    monkeypatch.setenv("ARTEMIS_PROXY_MAX_BODY_BYTES", "512")
+    with pytest.raises(RequestBudgetExceeded) as caught:
+        model._get_request_payload("x" * 1000)
+    failure = classify_failure(caught.value)
+    assert failure.category == FailureCategory.BAD_REQUEST
+    assert not failure.retryable and not failure.should_fallback
+
+
+def test_budget_covers_tool_schema(monkeypatch):
+    monkeypatch.setenv("ARTEMIS_PROXY_MAX_BODY_BYTES", "1024")
+    model = ProxyChatOpenAI(model="test", api_key="unused")
+    with pytest.raises(RequestBudgetExceeded):
+        model._get_request_payload("small", tools=[{"description": "x" * 2000}])
