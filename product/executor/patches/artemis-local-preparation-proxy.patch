+"""Bounded OpenAI-compatible proxy transport; never logs request contents."""
+from typing import Any
+import os
+
+import httpx
+from langchain_openai import ChatOpenAI
+
+
+class RequestBudgetExceeded(ValueError):
+    status_code = 413
+
+
+class ProxyChatOpenAI(ChatOpenAI):
+    def _get_request_payload(self, input_: Any, *, stop: list[str] | None = None, **kwargs: Any) -> dict:
+        payload = super()._get_request_payload(input_, stop=stop, **kwargs)
+        limit = int(os.environ.get("ARTEMIS_PROXY_MAX_BODY_BYTES", "786432"))
+        if limit <= 0:
+            raise RequestBudgetExceeded("Invalid proxy request budget")
+        # HTTPX JSON serialization, including tools/schema and all message content.
+        size = len(httpx.Request("POST", "https://budget.invalid", json=payload).content)
+        if size > limit:
+            raise RequestBudgetExceeded(f"Proxy request budget exceeded: {size} > {limit} bytes")
+        return payload
+
+    def with_structured_output(self, schema: Any = None, *, method: str = "function_calling", **kwargs: Any) -> Any:
+        # The configured intermediary rejects OpenAI response_format JSON Schema.
+        # Tool calling still uses LangChain's Pydantic validation on the response.
+        if method == "json_schema":
+            method = "function_calling"
+        return super().with_structured_output(schema, method=method, **kwargs)
