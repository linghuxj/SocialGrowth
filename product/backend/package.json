{
  "name": "@socialgrowth/product-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm --filter @socialgrowth/product-contracts build",
    "build": "tsc -p tsconfig.json",
    "precheck": "pnpm --filter @socialgrowth/product-contracts build",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src",
    "operator:admin": "tsx src/operator-admin.ts",
    "admission:reconcile": "tsx src/network-admission-reconcile.ts",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "pretest": "pnpm --filter @socialgrowth/product-contracts build",
    "test": "tsx --test --test-concurrency=1 src/*.test.ts",
    "test:postgres": "tsx --test --test-concurrency=1 src/*.postgres-test.ts",
    "test:storage": "tsx --test --test-concurrency=1 src/*.storage-test.ts",
    "test:upload-storage": "tsx --test --test-concurrency=1 src/material-upload-store.storage-sql-test.ts",
    "test:material-api-storage": "tsx --test --test-concurrency=1 src/material-upload-api.storage-sql-test.ts",
    "test:material-registry-api-storage": "tsx --test --test-concurrency=1 src/material-registry-api.storage-sql-test.ts",
    "test:material-batch-api-storage": "tsx --test --test-concurrency=1 src/material-batch-api.storage-sql-test.ts",
    "test:material-library-postgres": "tsx --test --test-concurrency=1 src/material-library-api.pg-test.ts",
    "test:upload-inventory-postgres": "tsx --test --test-concurrency=1 src/material-upload-inventory-api.pg-test.ts",
    "test:resource-preparation-postgres": "tsx --test --test-concurrency=1 src/resource-preparation-api.pg-test.ts",
    "test:media-credentials-postgres": "tsx --test --test-concurrency=1 src/media-credential-store.pg-test.ts",
    "test:media-credentials-api-postgres": "tsx --test --test-concurrency=1 src/media-credentials-api.pg-test.ts",
    "test:media-key-custodian-postgres": "tsx --test --test-concurrency=1 src/media-credential-key-custodian.pg-test.ts",
    "test:task-recheck-redis": "tsx --test --test-concurrency=1 src/task-recheck-queue.redis-test.ts",
    "test:task-assistance-recheck-pg": "tsx --test --test-concurrency=1 src/task-assistance-recheck-store.pg-test.ts",
    "test:task-recheck-outbox": "tsx --test --test-concurrency=1 src/task-recheck-journal.pg-redis-test.ts",
    "test:database-backup": "tsx --test --test-concurrency=1 src/database-backup.pg-test.ts",
    "test:database-inventory": "tsx --test --test-concurrency=1 src/database-restore-inventory.pg-test.ts"
  },
  "dependencies": {
    "@alicloud/dysmsapi20170525": "4.6.0",
    "@alicloud/openapi-client": "0.4.15",
    "@alicloud/tea-util": "1.4.11",
    "@aws-sdk/client-s3": "3.1143.0",
    "@nestjs/common": "12.1.1",
    "@nestjs/core": "12.1.1",
    "@nestjs/platform-express": "12.1.1",
    "@socialgrowth/product-contracts": "workspace:*",
    "bullmq": "6.3.10",
    "ioredis": "6.0.0",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ws": "8.18.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/pg": "8.20.0",
    "@types/ws": "8.18.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
